# Back-end
(
  cd backend

  # Mesmo valor falso da CI, só para o Prisma e o envalid não reclamarem.
  export DATABASE_URL="${DATABASE_URL:-mysql://ci:ci@localhost:3306/ci}"

  npx prisma generate
  npm run typecheck
