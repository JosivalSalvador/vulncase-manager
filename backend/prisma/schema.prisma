// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum AssetType {
  WEB
  MOBILE
  NETWORK
  CODE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @unique
  fullname  String
  password  String // guarda o HASH (bcrypt), nunca a senha pura
  role      Role     @default(ANALYST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      ProjectMember[]
  ownedProjects    Project[]       @relation("ProjectOwner")
  reportedFindings Finding[]       @relation("FindingReporter")
  assignedFindings Finding[]       @relation("FindingAssignee")
  evidences        Evidence[]
  statusChanges    StatusHistory[]
}

model Project {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  description String?  @db.Text
  ownerId     String   @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members  ProjectMember[]
  assets   Asset[]
  findings Finding[]

  @@index([ownerId])
}

model ProjectMember {
  projectId String   @db.Char(36)
  userId    String   @db.Char(36)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Asset {
  id         String    @id @default(uuid()) @db.Char(36)
  name       String
  type       AssetType
  identifier String? // URL, IP, nome do pacote, repositório...
  projectId  String    @db.Char(36)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([projectId])
}

model Finding {
  id            String        @id @default(uuid()) @db.Char(36)
  title         String
  description   String        @db.Text
  severity      Severity
  status        FindingStatus @default(OPEN)
  remediation   String?       @db.Text // correção proposta
  owaspCategory String? // ex.: "A03:2021"
  cwe           String? // ex.: "CWE-89"
  cve           String? // ex.: "CVE-2024-12345"
  dueDate       DateTime?
  projectId     String        @db.Char(36)
  assetId       String?       @db.Char(36)
  reporterId    String        @db.Char(36)
  assigneeId    String?       @db.Char(36)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reporter  User            @relation("FindingReporter", fields: [reporterId], references: [id])
  assignee  User?           @relation("FindingAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  evidences Evidence[]
  history   StatusHistory[]

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assigneeId])
  @@index([assetId])
}

model Evidence {
  id           String   @id @default(uuid()) @db.Char(36)
  findingId    String   @db.Char(36)
  uploadedById String   @db.Char(36)
  storedName   String // nome gerado pelo servidor (uuid + extensão)
  originalName String // nome que o usuário enviou, só para exibir
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([findingId])
}

model StatusHistory {
  id          String         @id @default(uuid()) @db.Char(36)
  findingId   String         @db.Char(36)
  changedById String         @db.Char(36)
  fromStatus  FindingStatus? // null = criação do achado
  toStatus    FindingStatus
  createdAt   DateTime       @default(now())

  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([findingId])
}
