{
  "name": "vulncase-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start:prod": "node dist/main.js",
    "seed": "tsx src/seed/seed.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write src/",
    "format:check": "prettier src/ --check",
    "test": "vitest run --reporter=default --reporter=html --coverage",
    "test:unit": "vitest run --project unit",
    "test:db": "docker compose up -d --wait db-test redis",
    "test:integration": "npm run test:db && vitest run --project integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosivalSalvador/vulncase-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JosivalSalvador/vulncase-manager/issues"
  },
  "homepage": "https://github.com/JosivalSalvador/vulncase-manager#readme",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^18.0.10",
    "envalid": "^9.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
