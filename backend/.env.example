# App
NODE_ENV=development
PORT=3333

# MySQL (o docker compose lê estas variáveis)
MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_USER=vulncase
MYSQL_PASSWORD=troque-a-senha-do-app
MYSQL_DATABASE=vulncase
DATABASE_URL=mysql://vulncase:troque-a-senha-do-app@localhost:3306/vulncase

# Front-end (origem liberada no CORS)
CORS_ORIGIN=http://localhost:5173

# Redis (sessões)
REDIS_URL=redis://localhost:6379

# Segredos: mínimo 32 caracteres cada, diferentes entre si e OBRIGATÓRIOS em produção.
# Gere cada um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-pelo-valor-gerado
CSRF_SECRET=troque-pelo-valor-gerado

# Cookies só por HTTPS. Em produção (HTTPS) use true; em desenvolvimento (HTTP) use false
COOKIE_SECURE=false

# Pasta onde as evidências enviadas ficam guardadas (fora do git)
UPLOAD_DIR=uploads